#ifndef cbi
#define cbi(sfr, bit) (_SFR_BYTE(sfr) &= ~_BV(bit))
#endif
#ifndef sbi
#define sbi(sfr, bit) (_SFR_BYTE(sfr) |= _BV(bit))
#endif

//---------- Motor Driver Pins (TB6612FNG) -------------
#define AIN1 2
#define AIN2 4
#define PWMA 5

#define PWMB 6
#define BIN1 7
#define BIN2 8
#define STBY 9

//---------- Button and LED Pins -----------------------
#define CALIB_BUTTON 13//3   // SW1: Start Calibration
#define RUN_BUTTON   9//11//10  // SW2: Start/Stop Run

#define LED1 11          // Calibrating Indicator
#define LED2 12          // Ready to Run Indicator
#define LED3 13          // On Line Indicator

//---------- Global Variables --------------------------
bool isBlackLine = 1; // 1: Black line on white surface
int numSensors = 8;
int sensorWeight[8] = { 8, 4, 2, 1, -1, -2, -4, -8 };

int minValues[8], maxValues[8], threshold[8];
int sensorValue[8], sensorArray[8];

int P, D, I, PIDvalue;
int error, previousError;
int lsp, rsp;
int activeSensors;

float Kp = 0.10;//0.95;//1.1;//0.10;
float Kd = 10.0;//12.0;//18.0;//10.0;
float Ki = 0;//0.00020;//0;

int lfSpeed = 180;
int currentSpeed = 160;
bool onoff = 0;
bool onLine = 1;

void setup() {
  sbi(ADCSRA, ADPS2); cbi(ADCSRA, ADPS1); cbi(ADCSRA, ADPS0); // Set ADC speed

  Serial.begin(9600);

  pinMode(AIN1, OUTPUT);
  pinMode(AIN2, OUTPUT);
  pinMode(PWMA, OUTPUT);
  pinMode(BIN1, OUTPUT);
  pinMode(BIN2, OUTPUT);
  pinMode(PWMB, OUTPUT);
  pinMode(STBY, OUTPUT);
  digitalWrite(STBY, HIGH);

  pinMode(CALIB_BUTTON, OUTPUT);
  digitalWrite(CALIB_BUTTON,HIGH);
  pinMode(RUN_BUTTON, INPUT_PULLUP);
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(LED3, OUTPUT);
}

void loop() {
  // --- Calibration Mode ---
  digitalWrite(LED1, HIGH);
  while (digitalRead(CALIB_BUTTON) == HIGH) {} // Wait for button
  digitalWrite(LED1, LOW);
  delay(1000);
  calibrate();

  // --- Wait for RUN ---
  digitalWrite(LED2, HIGH);
  while (digitalRead(RUN_BUTTON) == HIGH) {}
  digitalWrite(LED2, LOW);
  delay(500);
  onoff = 1;

  while (1) {
    // Toggle RUN/STOP with button
    if (digitalRead(RUN_BUTTON) == LOW) {
      onoff = !onoff;
      delay(300);
    }

    if (onoff) {
      readLine();
      if (onLine) {
        digitalWrite(LED3, HIGH);
        lineFollow();
        if (currentSpeed < lfSpeed) currentSpeed++;
      } else {
        digitalWrite(LED3, LOW);
        // Off-line recovery turns
        if (error < 1000) {
          motor1run(0);
          motor2run(200);
        } else if (error > -1000) {
          motor1run(200);
          motor2run(0);
        }
      }
    } else {
      digitalWrite(LED3, LOW);
      motor1run(0);
      motor2run(0);
    }
  }
}

void calibrate() {
  for (int i = 0; i < 8; i++) {
    minValues[i] = analogRead(i);
    maxValues[i] = analogRead(i);
  }

  for (int i = 0; i < 10000; i++) {
    motor1run(70);
    motor2run(-70);
    for (int j = 0; j < 8; j++) {
      int val = analogRead(j);
      if (val < minValues[j]) minValues[j] = val;
      if (val > maxValues[j]) maxValues[j] = val;
    }
  }

  for (int i = 0; i < 8; i++) {
    threshold[i] = (minValues[i] + maxValues[i]) / 2;
  }

  motor1run(0);
  motor2run(0);
}

void readLine() {
  onLine = 0;
  for (int i = 0; i < 8; i++) {
    if (isBlackLine)
      sensorValue[i] = map(analogRead(i), minValues[i], maxValues[i], 0, 1000);
    else
      sensorValue[i] = map(analogRead(i), minValues[i], maxValues[i], 1000, 0);

    sensorValue[i] = constrain(sensorValue[i], 0, 1000);
    sensorArray[i] = sensorValue[i] > 500;

    if (sensorArray[i]) onLine = 1;
  }
}

void lineFollow() {
  error = 0;
  activeSensors = 0;

  for (int i = 0; i < 8; i++) {
    error += sensorWeight[i] * sensorArray[i] * sensorValue[i];
    activeSensors += sensorArray[i];
  }

  if (activeSensors != 0)
    error = error / activeSensors;

  P = error;
  I += error;
  D = error - previousError;
  PIDvalue = (Kp * P) + (Ki * I) + (Kd * D);
  previousError = error;

  lsp = currentSpeed - PIDvalue;
  rsp = currentSpeed + PIDvalue;

  lsp = constrain(lsp, 0, 255);
  rsp = constrain(rsp, 0, 255);

  motor1run(rsp);
  motor2run(lsp);
}

void motor1run(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, LOW);
  } else if (speed < 0) {
    digitalWrite(AIN1, LOW);
    digitalWrite(AIN2, HIGH);
    speed = -speed;
  } else {
    digitalWrite(AIN1, HIGH);
    digitalWrite(AIN2, HIGH);
    speed = 0;
  }
  analogWrite(PWMA, speed);
}

void motor2run(int speed) {
  speed = constrain(speed, -255, 255);
  if (speed > 0) {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, LOW);
  } else if (speed < 0) {
    digitalWrite(BIN1, LOW);
    digitalWrite(BIN2, HIGH);
    speed = -speed;
  } else {
    digitalWrite(BIN1, HIGH);
    digitalWrite(BIN2, HIGH);
    speed = 0;
  }
  analogWrite(PWMB, speed);
}
